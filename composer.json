{
    "name": "componenta/middleware-factory",
    "description": "PSR-15 middleware factory integration for Componenta",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.5.13",
        "componenta/arrayable": "^1.0",
        "componenta/config": "^4.0",
        "componenta/di": "^6.0",
        "componenta/pipeline": "^1.1",
        "psr/container": "^2.0",
        "psr/http-message": "^2.0",
        "psr/http-server-middleware": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Componenta\\Http\\Middleware\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Componenta\\Http\\Middleware\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "extra": {
        "componenta": {
            "config-providers": [
                "Componenta\\Http\\Middleware\\ConfigProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "3.0.x-dev",
            "dev-refactor/middleware-factory-audit": "3.0.x-dev"
        }
    },
    "require-dev": {
        "nyholm/psr7": "^1.8",
        "pestphp/pest": "^4.0",
        "phpbench/phpbench": "^1.7",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.0"
    },
    "scripts": {
        "test": "@php vendor/bin/pest",
        "phpstan": "@php vendor/bin/phpstan analyse src --level=max --no-progress",
        "benchmark": "@php vendor/bin/phpbench run --report=aggregate",
        "check": [
            "@test",
            "@phpstan"
        ]
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true,
        "audit": {
            "ignore-abandoned": {
                "doctrine/annotations": "Transitive PHPBench development dependency; benchmarks use PHP attributes. Security advisories remain enforced."
            }
        }
    }
}
