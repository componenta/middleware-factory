{
    "name": "componenta/middleware-legacy",
    "description": "Explicit single-pass and double-pass adapters for PSR-15 middleware",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "psr/container": "^2.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0"
    },
    "require-dev": {
        "componenta/pipeline": "^1.1.1",
        "nyholm/psr7": "^1.8",
        "pestphp/pest": "^4.0",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "Componenta\\Http\\Middleware\\Legacy\\": "src/"
        }
    },
    "scripts": {
        "test": "@php vendor/bin/pest",
        "phpstan": "@php vendor/bin/phpstan analyse src/SinglePassAdapter.php src/DoublePassAdapter.php src/Internal --level=max --no-progress",
        "check": [
            "@test",
            "@phpstan"
        ],
        "test:integration": "@php vendor/bin/pest integration-tests",
        "phpstan:integration": "@php vendor/bin/phpstan analyse src --level=max --no-progress"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "suggest": {
        "componenta/middleware-factory": "Install version 3.x to use the optional legacy signature resolvers (PHP 8.5.13+)."
    }
}
